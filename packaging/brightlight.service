[Unit]
Description=Brightlight LED lighting controller
Wants=network-online.target
After=network-online.target

[Service]
Environment=BRIGHTLIGHT=/opt/brightlight
WorkingDirectory=/opt/brightlight
ExecStart=/opt/brightlight/brightlight
Restart=always
RestartSec=5
# Don't let a wedged binary (e.g. blocked on USB serial) stall
# `systemctl stop` for the 90s default before SIGKILL
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
